<?xml version="1.0" encoding="utf-8"?>
<!--
    The privileged permissions MIS (com.xiaomi.mis 3.0.4) requests. A ROM that enforces this list
    (ro.control_privapp_permissions=enforce) refuses to boot when one is missing.
-->
<permissions>
    <privapp-permissions package="com.xiaomi.mis">
        <permission name="android.permission.BLUETOOTH_PRIVILEGED"/>
        <permission name="android.permission.LOCAL_MAC_ADDRESS"/>
        <permission name="android.permission.MODIFY_PHONE_STATE"/>
        <permission name="android.permission.OVERRIDE_WIFI_CONFIG"/>
        <permission name="android.permission.REAL_GET_TASKS"/>
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
        <permission name="android.permission.TETHER_PRIVILEGED"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>
</permissions>
